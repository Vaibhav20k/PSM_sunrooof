{"version": 2, "builds": [{"src": "api/*.js", "use": "@vercel/node", "config": {"maxDuration": 800, "includeFiles": ["lib/seed/**"]}}, {"src": "public/**", "use": "@vercel/static"}], "routes": [{"src": "/sync/status", "dest": "/api/status.js"}, {"src": "/sync", "dest": "/api/sync.js"}, {"src": "/data/(.*)", "dest": "/api/data.js?file=$1"}, {"src": "/api/(.*)", "dest": "/api/$1.js"}, {"src": "/", "dest": "/public/index.html"}, {"src": "/(.*)", "dest": "/public/$1"}], "crons": [{"path": "/api/sync", "schedule": "* * * * *"}]}